#pragma once

struct WifiCred {
  const char* ssid;
  const char* pass;
};

// 1. Copy this file to config.h:
//      cp include/config.h.example include/config.h
// 2. Replace the SSIDs and passwords below with your networks.
// 3. Add or remove entries as needed — the firmware tries them in order.
//
// config.h is gitignored so your secrets stay local.

static const WifiCred WIFI_NETWORKS[] = {
    {"YourHomeWifi", "your-home-password"},
    {"YourHackerspaceWifi", "your-hackerspace-password"},
};

static const size_t WIFI_NETWORK_COUNT =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);
