#pragma once

struct WifiCred {
  const char* ssid;
  const char* pass;
};

// 1. Copy this file to config.h:
//      cp include/config.h.example include/config.h
// 2. Replace the SSIDs and passwords below with your networks.
// 3. Add or remove entries as needed — the firmware tries them in order.
//
// config.h is gitignored so your secrets stay local.

static const WifiCred WIFI_NETWORKS[] = {
    {"YourHomeWifi", "your-home-password"},
    {"YourHackerspaceWifi", "your-hackerspace-password"},
};

static const size_t WIFI_NETWORK_COUNT =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// Fallback POSIX TZ if geo-IP lookup fails (normal path: auto from Wi‑Fi IP).
// Examples: "UTC0", "EST5EDT,M3.2.0,M11.1.0", "PST8PDT,M3.2.0,M11.1.0"
#ifndef PLEBWATCH_TZ
#define PLEBWATCH_TZ "CST6CDT,M3.2.0,M11.1.0"
#endif

// Watch face options
#ifndef PLEBWATCH_12HOUR
#define PLEBWATCH_12HOUR 0  // 1 = 12-hour clock
#endif

#ifndef PLEBWATCH_SATS_BALANCE
#define PLEBWATCH_SATS_BALANCE 210000ULL  // visual tracker only
#endif

// Brand orange #F6A916 as RGB565
#ifndef PLEBWATCH_ORANGE_RGB565
#define PLEBWATCH_ORANGE_RGB565 0xF542
#endif


